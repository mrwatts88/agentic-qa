{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/dist/cli.js\" hook",
            "timeout": 30,
            "statusMessage": "agentic-qa: checking rules"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/dist/cli.js\" stop --mechanical",
            "timeout": 300,
            "statusMessage": "agentic-qa: mechanical rules (judgment tiers off here)"
          }
        ]
      }
    ]
  }
}
